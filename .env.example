# Environment variables template
# Copy this file to .env and fill in your actual values

# API Base URL (without /api suffix - it will be added automatically)
# For Android emulator: http://10.0.2.2:3000
# For iOS simulator/web: http://localhost:3000
# For physical device: http://<your-computer-ip>:3000
# Example: If your computer IP is 192.168.1.100, use: http://192.168.1.100:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
